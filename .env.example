# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 24

# Postgres (app data + Temporal persistence)
POSTGRES_USER=openjidoka
POSTGRES_PASSWORD=replace-me-postgres-password
POSTGRES_DB=openjidoka
# Only used when running api/worker outside docker (pnpm dev:*)
DATABASE_URL=postgres://openjidoka:replace-me-postgres-password@localhost:5432/openjidoka

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=openjidoka

# API auth: bearer token the admin UI and external triggers must send (min 16 chars)
ADMIN_API_TOKEN=replace-me-admin-api-token
API_PORT=3000

# OpenJEV. OPENJEV_MODE=mock returns schema-shaped fake data so the stack runs without credentials.
# OPENJEV_MODE=http calls an OpenAI-compatible {OPENJEV_BASE_URL}/chat/completions endpoint.
OPENJEV_MODE=mock
OPENJEV_BASE_URL=
OPENJEV_API_KEY=
OPENJEV_MODEL=
OPENJEV_TIMEOUT_MS=120000

# Optional comma separated host allowlist for documents fetched by URL (e.g. "sharepoint.com,files.example.com").
DOCUMENT_URL_ALLOWLIST=
DOCUMENT_MAX_BYTES=20971520

# Connector secrets. Connections reference these by env var name (secretEnv); values never touch the DB.
# Only variables prefixed OPENJIDOKA_SECRET_ can be referenced, so workflows cannot read other worker env vars.
OPENJIDOKA_SECRET_SHAREPOINT=
OPENJIDOKA_SECRET_TEAMS_WEBHOOK=
OPENJIDOKA_SECRET_OUTLOOK=

# Host ports published by docker compose
ADMIN_PORT=8080
API_HOST_PORT=3000
TEMPORAL_UI_PORT=8233
WORKER_REPLICAS=1
