    "@openjidoka/integrations": "workspace:^",
    "@temporalio/client": "^1.25.0",
    "bpmn-auto-layout": "^1.3.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
